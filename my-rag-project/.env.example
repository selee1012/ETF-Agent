# 이 파일을 .env로 복사한 뒤 발급받은 키를 넣는다: cp .env.example .env
# .env는 gitignore되어 커밋되지 않는다(API 키 유출 방지).
OPENAI_API_KEY=your_api_key_here

# ---- (선택) 아래는 비워 두면 과제 기본값(GPT-4o, text-embedding-3-small)을 쓴다 ----
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OpenAI 대신 로컬 Ollama(OpenAI 호환 API)로 시험할 때만:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=gemma3:12b
# OPENAI_EMBEDDING_MODEL=snowflake-arctic-embed2
