# 개인용 로컬 설정 — .env.local로 복사해 쓴다: cp .env.local.example .env.local
# .env.local은 gitignore되어 커밋되지 않고, .env의 같은 이름 값을 덮어쓴다.
# 개인 API 키는 .env 또는 .env.local에만 둔다. 실행: ./scripts/run-local.sh
#
# 로컬 기본은 OpenAI API의 가벼운 모델이다(질문과 검색된 문서 일부가 OpenAI로 전송된다).
# 큰 모델 대신 프롬프트·RAG(미리 넣어 둔 문서)로 답변 품질을 맞추고, 응답 속도를 우선한다.

# ---------- 일반 대화 모드 (개인용 ChatGPT처럼) ----------
# ETF와 무관한 질문, 등록 문서에 근거가 없는 질문에도 모델이 자유롭게 답한다.
# ETF 질문은 기존 에이전트·출처·고지를 그대로 타고, 고위험·ETF 추천은 계속 고정 안내로 답한다.
# 금칙 표현(수익 보장 등)·개인정보 룰 가드는 일반 대화에도 적용된다. APP_ENV=local에서만 켤 수 있다.
GENERAL_CHAT_ENABLED=true
# 기억할 최근 대화 턴 수, 답변 최대 길이, 글자 단위 출력 지연(타이핑 효과, 0이면 끔)
HISTORY_TURNS=6
LLM_MAX_TOKENS=1200
STREAM_TOKEN_DELAY_MS=3

# ---------- 모델: OpenAI API ----------
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
# 키가 .env에 이미 있으면 주석으로 둔다. 여기에 넣으려면 주석을 풀고 값을 넣는다
# LLM_API_KEY=
# 가장 가벼운 추론형 모델 + 생각 분량 none(가장 빠름). 품질이 부족하면 gpt-5.4-mini
LLM_MODEL=gpt-5.4-nano
# 검증(judge) 모델도 같은 모델로(.env의 큰 모델 설정을 덮는다)
JUDGE_MODEL=gpt-5.4-nano
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
OPENAI_OMIT_TEMPERATURE=true
OPENAI_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=30
# 임베딩: DB 컬럼이 1024차원이라 dimensions=1024로 줄여 받는다. 모델을 바꾸면 ingest가 다시 임베딩한다
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_REQUEST_DIMENSIONS=true

# ---------- 대안: Azure OpenAI(무료 체험 크레딧) ----------
# 같은 openai_compat 어댑터로 v1 엔드포인트에 붙는다. 모델 이름 = Azure 배포 이름.
# 무료 체험 구독은 gpt-5-mini·text-embedding-3-small(GlobalStandard)만 할당량이 있다(2026-11 koreacentral 기준).
# 키: az cognitiveservices account keys list -g <리소스그룹> -n <리소스> --query key1 -o tsv
# LLM_BASE_URL=https://<리소스 이름>.openai.azure.com/openai/v1/
# LLM_API_KEY=
# LLM_MODEL=gpt-5-mini
# JUDGE_MODEL=gpt-5-mini
