# 개인용 로컬 설정 — .env.local로 복사해 쓴다: cp .env.local.example .env.local
# .env.local은 gitignore되어 커밋되지 않고, .env의 같은 이름 값을 덮어쓴다.
# 개인 API 키는 .env.local에만 둔다. 실행: ./scripts/run-local.sh
#
# 아래 방식 중 하나만 켠다(같은 이름이 여러 번 나오면 마지막 값이 쓰인다).

# ---------- 일반 대화 모드 (개인용 ChatGPT처럼) ----------
# ETF와 무관한 질문, 등록 문서에 근거가 없는 질문에도 모델이 자유롭게 답한다.
# ETF 질문은 기존 에이전트·출처·고지를 그대로 타고, 고위험·ETF 추천은 계속 고정 안내로 답한다.
# 금칙 표현(수익 보장 등)·개인정보 룰 가드는 일반 대화에도 적용된다. APP_ENV=local에서만 켤 수 있다.
GENERAL_CHAT_ENABLED=true
# 기억할 최근 대화 턴 수, 답변 최대 길이, 창의성(0~2), 글자 단위 출력 지연(타이핑 효과)
HISTORY_TURNS=8
LLM_MAX_TOKENS=2000
GENERAL_CHAT_TEMPERATURE=0.7
STREAM_TOKEN_DELAY_MS=8

# ========== 방식 1: Ollama (기본 — 질의·문서가 이 Mac 밖으로 나가지 않음) ==========
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
# 생성 모델(ollama pull로 받음). 한국어 우선이면 exaone3.5:7.8b(비상업 라이선스)
LLM_MODEL=gemma3:12b
# 임베딩 모델: DB 컬럼이 1024차원이라 1024차원 모델을 쓴다
EMBEDDING_MODEL=snowflake-arctic-embed2
EMBEDDING_DIM=1024
# 로컬 모델은 첫 호출(모델 로딩)이 느리다
LLM_TIMEOUT_SECONDS=180

# ========== 방식 2: OpenAI API (질의가 OpenAI 서버로 전송됨) ==========
# 방식 1 블록을 주석 처리하고 아래 주석을 푼다. LLM_API_KEY에 본인 키를 넣는다.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1024
# EMBEDDING_REQUEST_DIMENSIONS=true
# LLM_TIMEOUT_SECONDS=60
#
# gpt-5·o 계열(추론형) 모델이면 아래도 켠다. 추론 토큰을 쓰므로 LLM_MAX_TOKENS를 넉넉히 둔다.
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
# OPENAI_OMIT_TEMPERATURE=true
# LLM_MAX_TOKENS=4000
#
# 방식 2-b: 생성은 OpenAI, 임베딩(문서 검색)은 로컬 Ollama로 두려면 위에 더해
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=snowflake-arctic-embed2
# EMBEDDING_REQUEST_DIMENSIONS=false
