# 사용법: cp .env.example .env 후 값을 채운다. 이 파일에는 이름과 설명만 둔다(값 금지).
# 비워 둔 항목은 apps/api/app/settings.py의 기본값이 쓰인다(DATABASE_URL은 필수).
# 셸 환경변수가 항상 우선한다(예: LLM_PROVIDER=fake make up).

# ---------- 앱 ----------
# 실행 환경: local | dev | prod (dev-login은 local에서만 열린다)
APP_ENV=
# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# CORS 허용 오리진(쉼표 구분). 로컬 기본값 http://localhost:5173
CORS_ORIGINS=

# ---------- DB ----------
# SQLAlchemy async URL. 로컬 compose: postgresql+asyncpg://<사용자>:<비밀번호>@db:5432/<DB>. 필수
DATABASE_URL=
# 로컬 db 컨테이너 계정·DB 이름·호스트 포트
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# (선택) make test가 쓸 DB URL. 비우면 POSTGRES_* 로 localhost URL을 조합하고 DB 이름 뒤에 _test를 붙인다
TEST_DATABASE_URL=

# ---------- 인증 ----------
# 인증 어댑터: local(자체 발급 JWT) | supabase(스텁) | entra(스텁, Microsoft Entra External ID)
AUTH_PROVIDER=
# 운영 화면 인증: local(role=admin) | cf_access(스텁)
ADMIN_AUTH=
# local JWT 서명 키(예: openssl rand -hex 32). 비우면 local 환경에서 재시작마다 새로 만든다
LOCAL_JWT_SECRET=
# local JWT 유효 시간(분)
LOCAL_JWT_TTL_MINUTES=
# dev-login 시 role=admin을 받을 이메일(쉼표 구분). 기본 admin@local.test
ADMIN_EMAILS=
# [나중] Supabase Auth
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# [나중] Microsoft Entra External ID(외부 로그인 서비스를 쓸 때만)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# [나중] Cloudflare Access
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---------- LLM ----------
# LLM 어댑터: openai_compat(OpenAI API·Azure OpenAI·vLLM 등) | fake(테스트)
# 고도화(Azure) 설정 예시는 infra/azure/README.md, 개인용 로컬 설정은 .env.local(.env.local.example 참고)
LLM_PROVIDER=
# OpenAI 호환 API 베이스 URL(기본 https://api.openai.com/v1). Azure OpenAI는 https://<리소스>.openai.azure.com/openai/v1/, vLLM이면 내부 주소
LLM_BASE_URL=
# OpenAI API 키(OpenAI를 쓰면 필수). 키가 없는 내부 서버는 비워도 됨
LLM_API_KEY=
# 답변 생성 모델 이름(기본 gpt-5.4-nano, README 참고). Azure OpenAI는 배포 이름
LLM_MODEL=
# 검증(judge) 모델 이름. 비우면 LLM_MODEL
JUDGE_MODEL=
# LLM 호출 타임아웃(초)·최대 토큰·온도
LLM_TIMEOUT_SECONDS=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=
# OpenAI API gpt-5·o 계열 호환: max_tokens | max_completion_tokens(기본), 온도 생략(true|false, 기본 true)
# vLLM 등 예전 형식 서버는 max_tokens / false
OPENAI_MAX_TOKENS_PARAM=
OPENAI_OMIT_TEMPERATURE=
# 추론형 모델(gpt-5 계열)의 생각 분량: off | none | minimal | low | medium | high (기본 none = 가장 빠름).
# off는 옵션을 보내지 않는다(vLLM 등). gpt-5(5.0)는 none 대신 minimal
OPENAI_REASONING_EFFORT=
# 임베딩 어댑터: openai_compat | fake. 비우면 LLM_PROVIDER
EMBEDDING_PROVIDER=
# 임베딩 API 베이스 URL. 비우면 LLM_BASE_URL
EMBEDDING_BASE_URL=
# 임베딩 모델 이름과 차원(chunks.embedding 컬럼 차원과 일치해야 함)
EMBEDDING_MODEL=
EMBEDDING_DIM=
# true면 임베딩 요청에 dimensions=EMBEDDING_DIM을 보낸다(OpenAI text-embedding-3 전용, 기본 false)
EMBEDDING_REQUEST_DIMENSIONS=

# ---------- LLM 폴백 ----------
# 폴백 어댑터: none | openai_compat. none이면 LLM 실패 시 바로 안전 답변
# openai_compat: 1순위(자체 호스팅 vLLM 등)가 실패하면 다른 OpenAI 호환 엔드포인트(Azure OpenAI)로 다시 호출
FALLBACK_PROVIDER=
# 폴백 엔드포인트·키·모델(Azure OpenAI는 배포 이름). openai_compat이면 URL과 모델은 필수
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# 폴백 모델의 생각 분량: off | none | minimal(기본) | low | medium | high
FALLBACK_REASONING_EFFORT=
# 폴백을 허용할 의도 목록(쉼표 구분)
FALLBACK_ALLOWED_INTENTS=

# ---------- 저장소·트레이서 ----------
# 파일 저장소: local | supabase(스텁) | azure_blob(스텁, Azure Blob Storage)
STORAGE_PROVIDER=
# local 저장소 경로(컨테이너는 compose가 /data/storage로 지정)
STORAGE_LOCAL_DIR=
# 트레이서: pg | langfuse(스텁)
TRACER=

# ---------- 에이전트 ----------
# 멀티턴에 쓰는 최근 턴 수
HISTORY_TURNS=
# 토큰 이벤트 사이 지연(ms, 타이핑 효과). 기본 0
STREAM_TOKEN_DELAY_MS=
# 하이브리드 검색 상위 k, 벡터 가중치(0~1), 근거 최소 점수
RAG_TOP_K=
RAG_VECTOR_WEIGHT=
RAG_MIN_SCORE=
# ETF명 오타 허용 기준(rapidfuzz 0~100)
ENTITY_FUZZY_THRESHOLD=
# 안전 답변·고위험 템플릿에 들어가는 문의 채널 문구
INQUIRY_CHANNEL=
# 일반 대화 모드(true|false, 기본 false). APP_ENV=local에서만 켤 수 있다(.env.local.example 참고)
GENERAL_CHAT_ENABLED=
# 일반 대화 답변 온도(0~2, 기본 0.7)
GENERAL_CHAT_TEMPERATURE=

# ---------- 외부 데이터 API ----------
# 공공데이터포털 서비스 키(증권상품시세정보)
DATA_GO_KR_API_KEY=
# DART 오픈API 인증키
DART_API_KEY=
# 외부 API 타임아웃(초)
EXTERNAL_TIMEOUT_SECONDS=

# ---------- 웹(compose web 서비스) ----------
# 브라우저가 호출할 API 주소. 기본 http://localhost:8000
VITE_API_BASE_URL=
# 인증 모드: local | supabase(미구현)
VITE_AUTH_MODE=
