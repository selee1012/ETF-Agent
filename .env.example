# 사용법: cp .env.example .env 후 값을 채운다. 이 파일에는 이름과 설명만 둔다(값 금지).
# 비워 둔 항목은 settings.py의 기본값이 쓰인다(DATABASE_URL은 필수).

# ---------- 앱 ----------
# 실행 환경: local | dev | prod
APP_ENV=
# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# CORS 허용 오리진(쉼표 구분), 예: 로컬 Vite 주소, Cloudflare Pages 도메인
CORS_ORIGINS=

# ---------- DB ----------
# SQLAlchemy async URL (postgresql+asyncpg://사용자:비밀번호@호스트:포트/DB). 필수
DATABASE_URL=
# [dev 프로필 전용] 로컬 pgvector 컨테이너 계정·DB 이름·호스트 포트
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# (선택) make test가 쓸 DB URL. 비우면 POSTGRES_* 값으로 localhost URL을 조합
TEST_DATABASE_URL=

# ---------- Supabase Auth ----------
# Supabase 프로젝트 URL (https://<ref>.supabase.co)
SUPABASE_URL=
# JWT 서명 공개키 JWKS URL. 비우면 SUPABASE_URL에서 유도
SUPABASE_JWKS_URL=
# (선택) 레거시 HS256 JWT 시크릿. JWKS 비대칭 키를 쓰면 비워 둔다
SUPABASE_JWT_SECRET=

# ---------- LLM ----------
# 1순위 LLM 어댑터: openai_compat | fake
LLM_PROVIDER=
# OpenAI 호환 API 베이스 URL (Ollama는 .../v1)
LLM_BASE_URL=
# (선택) OpenAI 호환 API 키. Ollama는 비워도 됨, vLLM --api-key 사용 시 필요
LLM_API_KEY=
# 답변 생성 모델 이름
LLM_MODEL=
# LLM-as-judge 평가 모델 이름
JUDGE_MODEL=
# 임베딩 모델 이름
EMBEDDING_MODEL=
# 임베딩 차원(pgvector 컬럼 차원과 일치해야 함)
EMBEDDING_DIM=

# ---------- LLM 폴백 ----------
# 폴백 어댑터: bedrock | none
FALLBACK_PROVIDER=
# Bedrock 리전
BEDROCK_REGION=
# Bedrock 모델(또는 추론 프로파일) ID
BEDROCK_MODEL_ID=
# 폴백을 허용할 의도 목록(쉼표 구분)
FALLBACK_ALLOWED_INTENTS=
# Bedrock 자격증명은 이 파일에 두지 않는다: EC2는 인스턴스 역할, 로컬은 셸의 AWS_PROFILE 사용

# ---------- 어댑터 선택 ----------
# 인증: supabase | cognito
AUTH_PROVIDER=
# 파일 저장소: supabase | s3
STORAGE_PROVIDER=
# 트레이서: pg | langfuse
TRACER=

# ---------- Cloudflare ----------
# Cloudflare Access 팀 도메인 (<team>.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# Cloudflare Access 애플리케이션 AUD 태그
CF_ACCESS_AUD=
# cloudflared 원격 관리 터널 토큰 (docker compose의 cloudflared 서비스가 사용)
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- 외부 데이터 API ----------
# 공공데이터포털 서비스 키
DATA_GO_KR_API_KEY=
# DART 오픈API 인증키
DART_API_KEY=
