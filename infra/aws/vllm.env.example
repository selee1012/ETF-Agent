# 고도화 버전 B/C: AWS 자체 호스팅 sLLM(vLLM) + Bedrock 임베딩·폴백 (infra/aws/README.md 참고)
# 배포 환경의 환경변수에 옮겨 쓴다. 비밀값은 넣지 않는다.
APP_ENV=prod
LLM_PROVIDER=openai_compat
# vLLM 서버(프라이빗 서브넷) 주소
LLM_BASE_URL=http://vllm.internal:8000/v1
# vllm serve --served-model-name 값
LLM_MODEL=midm-2.0-mini
LLM_TIMEOUT_SECONDS=30
# vLLM은 예전 OpenAI 형식: max_tokens·온도 사용, 생각 분량 옵션 없음
OPENAI_MAX_TOKENS_PARAM=max_tokens
OPENAI_OMIT_TEMPERATURE=false
OPENAI_REASONING_EFFORT=off
LLM_MAX_TOKENS=800
EMBEDDING_PROVIDER=bedrock
BEDROCK_REGION=ap-northeast-2
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
# C: vLLM 장애 시 FAQ만 Bedrock으로 넘긴다(쓰지 않으면 none)
FALLBACK_PROVIDER=bedrock
# 폴백 모델 ID(FALLBACK_PROVIDER=bedrock이면 필수, 비어 있으면 기동 실패)
BEDROCK_MODEL_ID=
FALLBACK_ALLOWED_INTENTS=faq
