# 고도화 버전 A: AWS Bedrock (infra/aws/README.md 참고)
# 배포 환경의 환경변수(ECS 태스크 정의·Secrets Manager 등)에 옮겨 쓴다. 비밀값은 넣지 않는다.
APP_ENV=prod
LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-northeast-2
# 생성 모델 ID 또는 교차 리전 추론 프로필 ID(콘솔 Bedrock → Model catalog에서 확인)
LLM_MODEL=
# 검증(judge) 모델 ID. 비우면 LLM_MODEL
JUDGE_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
FALLBACK_PROVIDER=none
