# 고도화 버전 B: Azure GPU VM/AKS에 자체 호스팅 sLLM(vLLM) (infra/azure/README.md 참고)
# 배포 환경의 환경변수에 옮겨 쓴다. 비밀값은 넣지 않는다.
APP_ENV=prod
LLM_PROVIDER=openai_compat
# vLLM 서버(VNet 프라이빗 서브넷) 주소
LLM_BASE_URL=http://vllm.internal:8000/v1
# vllm serve --served-model-name 값
LLM_MODEL=midm-2.0-mini
LLM_TIMEOUT_SECONDS=30
# vLLM은 예전 OpenAI 형식: max_tokens·온도 사용, 생각 분량 옵션 없음
OPENAI_MAX_TOKENS_PARAM=max_tokens
OPENAI_OMIT_TEMPERATURE=false
OPENAI_REASONING_EFFORT=off
LLM_MAX_TOKENS=800
# 임베딩: Azure OpenAI를 섞어 쓰려면 EMBEDDING_BASE_URL을 따로 준다.
# API 키는 LLM_API_KEY 하나를 같이 쓰므로 vLLM을 --api-key로 같은 값에 맞춘다
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_BASE_URL=https://<리소스 이름>.openai.azure.com/openai/v1/
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_REQUEST_DIMENSIONS=true
FALLBACK_PROVIDER=none
