# 고도화 버전 A: Azure OpenAI (infra/azure/README.md 참고)
# 배포 환경의 환경변수(Container Apps·Key Vault 비밀 참조)에 옮겨 쓴다. 비밀값은 넣지 않는다.
APP_ENV=prod
LLM_PROVIDER=openai_compat
# v1 엔드포인트(OpenAI API와 같은 형식)
LLM_BASE_URL=https://<리소스 이름>.openai.azure.com/openai/v1/
# LLM_API_KEY는 Key Vault 비밀 참조로 주입한다
# 생성 모델 배포 이름(모델 이름이 아니라 Azure에서 만든 배포 이름)
LLM_MODEL=
# 검증(judge) 모델 배포 이름. 비우면 LLM_MODEL
JUDGE_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
OPENAI_OMIT_TEMPERATURE=true
# gpt-5(5.0) 계열은 none 대신 minimal
OPENAI_REASONING_EFFORT=minimal
# 임베딩 배포 이름. 로컬과 같은 모델·차원이면 다시 임베딩하지 않는다
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_REQUEST_DIMENSIONS=true
FALLBACK_PROVIDER=none
# 저장소·인증(스텁 구현 후): STORAGE_PROVIDER=azure_blob, AUTH_PROVIDER=local 또는 entra
